# Optional. Leave unset to use the built-in rule-based parser only.
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=
HF_INTENT_MODEL=facebook/bart-large-mnli
# Off by default. When true, rephrases replies to sound more conversational
# and generates smart conversation titles — but it's a live LLM call on
# nearly every message and on every new conversation's first message, using
# a paid inference provider's free monthly credit allowance (separate, much
# smaller quota than the classification calls above). That latency (2-6s+
# per call, sometimes worse) is the main cost of turning this on, so it's
# off by default — falls back to the plain template reply / a truncated
# title either way if credits are exhausted or the call fails.
HF_REPLY_ENABLED=false
HF_REPLY_MODEL=google/gemma-2-2b-it:featherless-ai
# Tried only when HF_REPLY_MODEL fails for a reason OTHER than quota
# exhaustion (timeout, connection error, a provider-specific capacity
# error). HF's free third-party quota is one pool shared across every
# provider, so this isn't a second quota — it's resilience against a
# single provider having a bad moment, not against running out of credits.
HF_REPLY_FALLBACK_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita

# Optional. Defaults to a local SQLite file.
# DATABASE_URL=mysql+pymysql://user:password@localhost/todo_bot

# Optional IANA timezone name (e.g. America/New_York, Europe/London).
# Every due date and timestamp is computed in this timezone. Leave unset to
# use the server process's own system timezone — only set this if that
# might not match where you actually live (a cloud host, a dev sandbox).
APP_TIMEZONE=
