# Optional. Leave unset to use the built-in rule-based parser only.
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=
HF_INTENT_MODEL=facebook/bart-large-mnli
# Rephrases replies to sound more conversational. Uses a paid inference
# provider's free monthly credit allowance (separate, much smaller quota than
# the classification calls above) — falls back to the plain template reply
# if credits are exhausted or the call fails.
HF_REPLY_MODEL=google/gemma-2-2b-it:featherless-ai

# Optional. Defaults to a local SQLite file.
# DATABASE_URL=mysql+pymysql://user:password@localhost/todo_bot

# Optional. Leave unset for in-app (toast) notifications only.
# Enables email delivery for due reminders via the background scheduler.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
