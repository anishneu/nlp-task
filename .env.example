# Used by docker-compose.yml. Copy to .env in this same directory.
# All optional — leave blank to run with just the rule-based parser and
# in-app notifications only.

HF_TOKEN=
HF_INTENT_MODEL=facebook/bart-large-mnli
HF_REPLY_MODEL=google/gemma-2-2b-it:featherless-ai
# Tried only on a non-quota failure of HF_REPLY_MODEL — HF's free
# third-party quota is one pool shared across providers, so this isn't a
# second quota, just resilience against a single provider's outage.
HF_REPLY_FALLBACK_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita

# IANA timezone (e.g. America/New_York) — set this if the machine running
# the container isn't in your own timezone, otherwise due dates/timestamps
# will be computed against the container's clock instead of yours.
APP_TIMEZONE=
